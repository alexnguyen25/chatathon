// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
//
//     cp ios/Config/Secrets.xcconfig.example ios/Config/Secrets.xcconfig
//
// The value flows: xcconfig -> Info.plist -> InfoPlistAPIKeyStore at runtime.
// Leave it empty to run the demo against the canned suggestion instead.
//
// NOTE: `//` starts a comment in xcconfig, so a raw URL would be truncated.
// A bare key has no `//` in it, so this is safe as written.

ANTHROPIC_API_KEY =
